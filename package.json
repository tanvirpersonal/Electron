{
  "name": "electron-studio",
  "private": true,
  "version": "1.0.0",
  "description": "ELECTRON — a browser-based 3D asset studio",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^7.1.0",
    "concurrently": "^9.2.1",
    "electron": "^39.0.0",
    "wait-on": "^8.0.4"
  },
  "main": "main.cjs"
}